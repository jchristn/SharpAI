<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>sharpai-tui</AssemblyName>
    <RootNamespace>SharpAI.Tui</RootNamespace>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>4.0.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Test.Shared" />
    <InternalsVisibleTo Include="Test.Benchmark" />
    <PackageReference Include="Radiant" Version="0.1.3" />
    <PackageReference Include="TUIKit" Version="1.12.0" />
    <ProjectReference Include="../../sdk/csharp/src/SharpAI.Client/SharpAI.Client.csproj" />
    <EmbeddedResource Include="../../dashboard/src/api/operations.json" LogicalName="SharpAI.Tui.operations.json" />
    <EmbeddedResource Include="../../dashboard/src/i18n/*.json" LogicalName="SharpAI.Tui.Localization.%(Filename).json" />
    <EmbeddedResource Include="Localization/operator.json" LogicalName="SharpAI.Tui.Localization.operator.json" />
    <EmbeddedResource Include="parity.json" LogicalName="SharpAI.Tui.parity.json" />
  </ItemGroup>
</Project>
