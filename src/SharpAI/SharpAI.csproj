<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<Version>2.0.0</Version>
		<LlamaSharpVersion>0.30.0</LlamaSharpVersion>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Title>SharpAI</Title>
		<Authors>Joel Christner</Authors>
		<Description>Transform your .NET applications into AI powerhouses - embed models directly or deploy as an Ollama-compatible API server. No cloud dependencies, no limits, just pure local inference.</Description>
		<Copyright>(c)2025 Joel Christner</Copyright>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<DocumentationFile>SharpAI.xml</DocumentationFile>
		<ApplicationIcon>logo.ico</ApplicationIcon>
		<PackageProjectUrl>https://github.com/jchristn/sharpai</PackageProjectUrl>
		<PackageIcon>logo.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/jchristn/sharpai</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>ai embedding embeddings completion completions chat assistant agent model models huggingface ollama openai inference llama gguf telemetry</PackageTags>
		<PackageReleaseNotes>2.0.0: unified enterprise release. GGUF-native chat templates, concurrent inference and model lifecycle management, four-database support, telemetry (Radiant + Watson 7.2, Prometheus/Loki/Grafana/Tempo), tool calling, and vision/llava removed. See CHANGELOG.md.</PackageReleaseNotes>
		<PackageLicenseFile>LICENSE.md</PackageLicenseFile>
		<IncludeSymbols>True</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="logo.ico" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\assets\logo.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\..\LICENSE.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Inputty" Version="1.0.14" />
		<AssemblyMetadata Include="LlamaSharpVersion" Value="$(LlamaSharpVersion)" />
		<PackageReference Include="LLamaSharp" Version="$(LlamaSharpVersion)" />
		<PackageReference Include="LLamaSharp.Backend.Cpu" Version="$(LlamaSharpVersion)" />
		<PackageReference Include="LLamaSharp.Backend.Cuda12" Version="$(LlamaSharpVersion)" />
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
		<PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
		<PackageReference Include="MySqlConnector" Version="2.6.2" />
		<PackageReference Include="Npgsql" Version="10.0.3" />
		<PackageReference Include="RestWrapper" Version="3.3.2" />
		<PackageReference Include="SyslogLogging" Version="2.4.1" />
		<!-- Override the vulnerable PKCS dependency brought in by Microsoft.Data.SqlClient. -->
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
		<PackageReference Include="System.Text.Json" Version="10.0.13" />
	</ItemGroup>
</Project>
