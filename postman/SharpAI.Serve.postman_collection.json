    {
      "name": "Service probes",
      "item": [
        {
          "id": "3825c01f-449a-5e35-b3e9-9dd582c3e0b7",
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"JSON body\", () => pm.expect(pm.response.json()).to.be.an(\"object\"));"
                ]
              }
            }
          ]
        },
