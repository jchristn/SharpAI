{
  "info": {
    "name": "SharpAI Standalone Serve",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Unauthenticated single-model SharpAI.Serve. Start sharpai serve model.gguf --served-model-name fixture. Select requests matching --api and model capabilities. No management endpoints."
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "model",
      "value": "fixture"
    }
  ],
